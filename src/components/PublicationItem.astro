---
const { publication } = Astro.props;
---

<li class="publication-item">
  <span class="publication-badge">{publication.type === 'in-submission' ? '投稿中' : publication.type === 'journal' || publication.type === 'under-review' ? '期刊' : publication.type === 'conference' ? '研討會' : publication.type === 'thesis' ? '學位論文' : '專書'}</span>
  <p>{publication.citation}</p>
</li>
